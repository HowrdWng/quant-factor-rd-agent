# Default mode is deterministic and does not need any keys.
AGENT_MODE=mock

# Live mode uses an OpenAI-compatible /v1/chat/completions endpoint.
# Keep the mock demo for portfolio walkthroughs; switch to live only locally.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=auto

# Local research reports and structured market-data exports.
QUANT_DATA_ROOT=./workspace
MARKET_DATA_PROVIDER=synthetic

# Docker Compose host mount. Example on Windows: E:/fin_data
QUANT_HOST_DATA=./workspace
